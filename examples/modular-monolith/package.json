    "@zudojs/lifecycle": "workspace:*",
    "@zudojs/permissions": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "^5.0.1"
