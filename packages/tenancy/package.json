{
  "name": "@zudojs/tenancy",
  "version": "0.1.0",
  "description": "Multi-tenant context and isolation with tenant resolution, AsyncLocalStorage propagation, resolver chains, trust levels, and guard middleware.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@zudojs/errors": "0.1.0",
    "@zudojs/constants": "0.1.0"
  },
  "peerDependencies": {
    "@zudojs/http": "0.1.0"
  },
  "peerDependenciesMeta": {
    "@zudojs/http": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "zudojs",
    "tenancy",
    "multi-tenant",
    "saas"
  ],
  "homepage": "https://github.com/oyinlola-tech/zudo#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/oyinlola-tech/zudo"
  }
}
