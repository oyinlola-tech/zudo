{
  "name": "@zudojs/serialization",
  "version": "1.0.1",
  "description": "Data translation layer with JSON serializer, type transformers, envelopes, and registry for Zudojs applications.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo",
    "!dist/.tsbuildinfo",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@zudojs/constants": "workspace:*",
    "@zudojs/errors": "workspace:*",
    "@zudojs/types": "workspace:*",
    "@zudojs/validation": "workspace:*"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "author": {
    "name": "Oluwayemi Oyinlola",
    "url": "https://github.com/oyinlola-tech"
  },
  "keywords": [
    "zudojs",
    "serialization",
    "json",
    "transformers"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "module": "./dist/index.js",
  "homepage": "https://github.com/oyinlola-tech/zudo#readme",
  "bugs": {
    "url": "https://github.com/oyinlola-tech/zudo/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/oyinlola-tech/zudo",
    "directory": "packages/serialization"
  }
}
