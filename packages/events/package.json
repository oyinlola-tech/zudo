{
  "name": "@zudojs/events",
  "version": "1.0.0",
  "description": "Event-driven architecture with event bus, emitter, middleware, and registry for decoupled communication.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@zudojs/errors": "workspace:*",
    "@zudojs/constants": "workspace:*"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "vitest": "^4.1.11",
    "typescript": "7.0.2"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "zudojs",
    "events",
    "event-bus",
    "pubsub"
  ],
  "homepage": "https://github.com/oyinlola-tech/zudo#readme",
  "bugs": {
    "url": "https://github.com/oyinlola-tech/zudo/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/oyinlola-tech/zudo",
    "directory": "packages/events"
  }
}
