{
  "name": "@zudojs/permissions",
  "version": "0.0.3",
  "description": "Generic authorization engine with RBAC, ABAC, resource authorization, wildcards, role hierarchy, policies, and abilities.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@zudojs/errors": "workspace:*",
    "@zudojs/constants": "workspace:*"
  },
  "peerDependencies": {
    "@zudojs/http": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@zudojs/http": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "zudojs",
    "rbac",
    "abac",
    "authorization",
    "permissions"
  ],
  "homepage": "https://github.com/oyinlola-tech/zudo#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/oyinlola-tech/zudo"
  }
}
