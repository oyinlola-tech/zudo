{
  "name": "@zudojs/database",
  "version": "1.0.0",
  "description": "Database abstraction layer with clients, repositories, transactions, and query building for Zudojs applications.",
  "license": "MIT",
  "author": {
    "name": "Oluwayemi Oyinlola",
    "url": "https://github.com/oyinlola-tech"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/databaseClient/index.d.ts",
      "import": "./dist/databaseClient/index.js",
      "default": "./dist/databaseClient/index.js"
    },
    "./repositories": {
      "types": "./dist/repository/index.d.ts",
      "import": "./dist/repository/index.js",
      "default": "./dist/repository/index.js"
    },
    "./transactions": {
      "types": "./dist/transaction/index.d.ts",
      "import": "./dist/transaction/index.js",
      "default": "./dist/transaction/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "prebuild": "prisma generate",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "postbuild": "node ./scripts/check-dist.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@zudojs/errors": "workspace:*"
  },
  "peerDependencies": {
    "@prisma/client": ">=7.0.0 <8"
  },
  "devDependencies": {
    "@prisma/client": "7.10.0",
    "prisma": "7.10.0",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "zudojs",
    "database",
    "repository",
    "query",
    "transactions"
  ],
  "homepage": "https://github.com/oyinlola-tech/zudo#readme",
  "bugs": {
    "url": "https://github.com/oyinlola-tech/zudo/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/oyinlola-tech/zudo",
    "directory": "packages/database"
  }
}
