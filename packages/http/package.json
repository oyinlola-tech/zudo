{
  "name": "@zudojs/http",
  "version": "1.4.3",
  "description": "HTTP primitives, request handling, routing, middleware, and server infrastructure for Zudojs applications.",
  "license": "MIT",
  "author": {
    "name": "Oluwayemi Oyinlola",
    "url": "https://github.com/oyinlola-tech"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@zudojs/crypto": "workspace:*",
    "@zudojs/errors": "workspace:*",
    "@zudojs/logger": "workspace:*",
    "@zudojs/middleware": "workspace:*",
    "@zudojs/openapi": "workspace:*",
    "@zudojs/security": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@zudojs/schema": "workspace:*",
    "fluent-ffmpeg": "^2.1.3",
    "sharp": "^0.35.4",
    "typescript": "7.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "zudojs",
    "http",
    "server",
    "middleware",
    "routing"
  ],
  "homepage": "https://zudojs.oyinlola.site/docs/packages-http",
  "bugs": {
    "url": "https://github.com/oyinlola-tech/zudo/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/oyinlola-tech/zudo",
    "directory": "packages/http"
  }
}
