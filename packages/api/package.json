{
  "name": "@zudojs/api",
  "version": "0.0.1",
  "description": "Application-facing API layer for Zudojs — operation definitions, execution context, interceptors, policies, and transport-agnostic contracts.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@zudojs/errors": "^0.0.1",
    "@zudojs/constants": "^0.0.1",
    "@zudojs/types": "^0.0.1",
    "@zudojs/schema": "^0.0.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "zudojs",
    "api",
    "operations",
    "interceptors"
  ],
  "homepage": "https://github.com/oyinlola-tech/zudo#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/oyinlola-tech/zudo"
  }
}
