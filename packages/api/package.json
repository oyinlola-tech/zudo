{
  "name": "@zudojs/api",
  "version": "1.2.4",
  "description": "Application-facing API layer for Zudojs — operation definitions, execution context, interceptors, and transport-agnostic contracts.",
  "license": "MIT",
  "author": {
    "name": "Oluwayemi Oyinlola",
    "url": "https://github.com/oyinlola-tech"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@zudojs/errors": "workspace:*",
    "@zudojs/openapi": "workspace:*",
    "@zudojs/queue": "workspace:*",
    "@zudojs/rpc": "workspace:*",
    "@zudojs/schema": "workspace:*",
    "@zudojs/security": "workspace:*",
    "@zudojs/serialization": "workspace:*",
    "@zudojs/types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "zudojs",
    "api",
    "operations",
    "interceptors",
    "rpc",
    "queue",
    "cli",
    "fetch"
  ],
  "homepage": "https://zudojs.oyinlola.site/docs/packages-api",
  "bugs": {
    "url": "https://github.com/oyinlola-tech/zudo/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/oyinlola-tech/zudo",
    "directory": "packages/api"
  }
}
