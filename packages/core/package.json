{
  "name": "@zudojs/core",
  "version": "1.0.0",
  "description": "Application lifecycle management, execution context propagation, and runtime orchestration for Zudojs applications.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors/index.js"
    },
    "./logging": {
      "types": "./dist/logging/index.d.ts",
      "import": "./dist/logging/index.js"
    },
    "./lifecycle": {
      "types": "./dist/lifecycle/index.d.ts",
      "import": "./dist/lifecycle/index.js"
    },
    "./context": {
      "types": "./dist/context/index.d.ts",
      "import": "./dist/context/index.js"
    },
    "./configuration": {
      "types": "./dist/configuration/index.d.ts",
      "import": "./dist/configuration/index.js"
    },
    "./modules": {
      "types": "./dist/modules/index.d.ts",
      "import": "./dist/modules/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@zudojs/errors": "workspace:*",
    "@zudojs/constants": "workspace:*"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "module": "./dist/index.js",
  "keywords": [
    "zudojs",
    "core",
    "lifecycle",
    "context"
  ],
  "homepage": "https://github.com/oyinlola-tech/zudo#readme",
  "bugs": {
    "url": "https://github.com/oyinlola-tech/zudo/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/oyinlola-tech/zudo",
    "directory": "packages/core"
  }
}
