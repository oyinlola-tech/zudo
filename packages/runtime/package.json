{
  "name": "@zudojs/runtime",
  "version": "0.0.1",
  "description": "Application lifecycle orchestrator with dependency ordering, rollback, signals, and readiness checks.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "tsc -p tsconfig.json --clean"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@zudojs/errors": "^0.0.1",
    "@zudojs/constants": "^0.0.1",
    "@zudojs/container": "^0.0.1",
    "@zudojs/config": "^0.0.1",
    "@zudojs/logger": "^0.0.1",
    "@zudojs/events": "^0.0.1",
    "@zudojs/core": "^0.0.1"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "module": "./dist/index.js",
  "keywords": [
    "zudojs",
    "runtime",
    "orchestrator",
    "services"
  ],
  "homepage": "https://github.com/oyinlola-tech/zudo#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/oyinlola-tech/zudo"
  }
}
