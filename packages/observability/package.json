{
  "name": "@zudojs/observability",
  "version": "1.0.0",
  "description": "Structured logging, metrics, tracing, context propagation, and exporters for Zudojs applications.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@zudojs/errors": "workspace:*"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "^4.1.11",
    "@types/node": "^26.4.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "zudojs",
    "observability",
    "metrics",
    "tracing",
    "logs"
  ],
  "homepage": "https://github.com/oyinlola-tech/zudo#readme",
  "bugs": {
    "url": "https://github.com/oyinlola-tech/zudo/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/oyinlola-tech/zudo",
    "directory": "packages/observability"
  }
}
