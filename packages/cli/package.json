{
  "name": "zudojs-cli",
  "version": "0.1.2",
  "description": "Command-line interface for scaffolding, generating, and managing Zudojs framework projects.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "module": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "zudojs": "./dist/src/bin/zudojs.js"
  },
  "files": [
    "dist",
    "src/scripts/postinstall.cjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/src/scripts && cp src/scripts/postinstall.cjs dist/src/scripts/postinstall.cjs",
    "dev": "tsx src/bin/zudojs.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node src/scripts/postinstall.cjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@zudojs/config": "0.1.0",
    "@zudojs/core": "0.1.0",
    "@zudojs/errors": "0.1.0",
    "@zudojs/logger": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.12",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "zudojs",
    "cli",
    "scaffold",
    "generate",
    "dev"
  ],
  "homepage": "https://github.com/oyinlola-tech/zudo#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/oyinlola-tech/zudo"
  }
}
