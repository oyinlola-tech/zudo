{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",

    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,

    "composite": true,
    "incremental": true,

    "noEmitOnError": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules", "**/*.test.ts", "**/*.spec.ts"],
  "references": [
    {
      "path": "../core"
    },
    {
      "path": "../config"
    },
    {
      "path": "../errors"
    },
    {
      "path": "../logger"
    }
  ]
}
