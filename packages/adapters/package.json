{
  "name": "@zudojs/adapters",
  "version": "0.1.0",
  "description": "Boundary layer between Zudojs and external platforms — adapter contracts, registry, capabilities, and transport abstractions.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@zudojs/errors": "0.1.0",
    "@zudojs/constants": "0.1.0",
    "@zudojs/types": "0.1.0",
    "@zudojs/lifecycle": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "zudojs",
    "adapter",
    "boundary",
    "external",
    "integration"
  ],
  "homepage": "https://github.com/oyinlola-tech/zudo#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/oyinlola-tech/zudo"
  }
}
