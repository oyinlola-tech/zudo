{
  "name": "@zudojs/testing",
  "version": "0.0.4",
  "description": "Test helpers, fixtures, mocks, and utilities for testing Zudojs applications.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "../../node_modules/.bin/vitest run"
  },
  "dependencies": {
    "@zudojs/config": "^0.0.1",
    "@zudojs/constants": "^0.0.1",
    "@zudojs/container": "^0.0.1",
    "@zudojs/errors": "^0.0.1",
    "@zudojs/events": "^0.0.1",
    "@zudojs/http": "^0.0.1",
    "@zudojs/logger": "^0.0.1",
    "@zudojs/messaging": "^0.0.1",
    "@zudojs/middleware": "^0.0.1",
    "@zudojs/queue": "^0.0.1",
    "@zudojs/security": "^0.0.1",
    "@zudojs/serialization": "^0.0.1",
    "@zudojs/storage": "^0.0.1",
    "@zudojs/types": "^0.0.1",
    "@zudojs/validation": "^0.0.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "zudojs",
    "testing",
    "mocks",
    "fixtures",
    "vitest"
  ],
  "homepage": "https://github.com/oyinlola-tech/zudo#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/oyinlola-tech/zudo"
  }
}
