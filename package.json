{
  "name": "zudojs",
  "version": "0.0.1",
  "private": true,
  "description": "Zudojs framework monorepo.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*",
    "examples/micro-service/*"
  ],
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean",
    "build:core": "pnpm --filter @zudojs/core run build",
    "typecheck:core": "pnpm --filter @zudojs/core run typecheck",
    "architect:check": "node scripts/architect-check.js",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "format": "prettier --write \"**/*.{ts,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md,yml,yaml}\"",
    "test": "pnpm vitest run tests/architect",
    "exports:check": "node scripts/check-exports.js",
    "consumer:check": "node scripts/check-consumer-imports.mjs",
    "site:seo": "node scripts/site-seo.mjs",
    "site:llms": "node scripts/site-llms.mjs",
    "site:learn": "node scripts/site-learn.mjs",
    "site:learn:check": "node scripts/site-learn.mjs --check",
    "site:learn:bundle": "node scripts/site-learn-bundle.mjs",
    "site:indexnow": "node scripts/site-indexnow.mjs",
    "site:css": "npx -y tailwindcss@3.4.17 -c site/tailwind.config.cjs -i site/css/tailwind.src.css -o site/css/tailwind.css --minify",
    "site:brand": "node scripts/site-brand.mjs",
    "site:exports": "node scripts/site-export-index.mjs",
    "site:exports:check": "node scripts/site-export-index.mjs --check",
    "site:shots": "node scripts/site-shots.mjs",
    "site:theme": "node scripts/site-theme.mjs",
    "site:tokenize": "node scripts/site-tokenize.mjs",
    "release:check": "pnpm architect:check && pnpm -r --filter \"./packages/**\" run build && pnpm exports:check && pnpm consumer:check && pnpm -r run typecheck && pnpm test:all",
    "test:all": "pnpm -r --workspace-concurrency=2 run test"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.24.0",
  "overrides": {
    "fast-uri": "^3.1.7"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.2",
    "prettier": "^3.9.9",
    "vitest": "^5.0.1"
  }
}
